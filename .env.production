# VM107 Agent Zero - Production Environment Configuration
# Mirror of .env.local but with production hosts/IPs.
# NEVER commit production secrets to git.

# =============================================================================
# Ollama Configuration (REQUIRED — Proxmox host)
# =============================================================================
OLLAMA_BASE_URL=http://192.168.1.113:11434

# =============================================================================
# Web UI Configuration
# =============================================================================
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=80

# =============================================================================
# Execution Boundary Configuration (Phase 38)
# =============================================================================
# Options: production, staging, research
A0_ENVIRONMENT=production

# =============================================================================
# MongoDB — persistent daily budget tracking + identity registry
# Prod MongoDB: 192.168.1.110:27017 (auth: admin / ChangeMe2025)
# (.104 hosts Postgres + Redis + Docker registry; Mongo lives on .110.
#  INDEX.md credentials table is authoritative — verified 2026-05-22 from LXC 207.)
# =============================================================================
MONGODB_URI=mongodb://admin:ChangeMe2025@192.168.1.110:27017/vm107_budgets?authSource=admin

# =============================================================================
# Redis Embedding Cache (Phase 41)
# =============================================================================
REDIS_URL=redis://vm107-redis:6379/0

# =============================================================================
# VM API endpoints (production IPs from reference_prod_infrastructure.md)
# =============================================================================
VM100_API_URL=http://192.168.1.200:8000
VM102_API_URL=http://192.168.1.202:8003
VM101_KB_SEARCH_URL=http://192.168.1.201:8001/api/v1/knowledge/search
# Phase 70.5 Plan 07 — VM101Client fail-fast (was hardcoded localhost:8001 before)
VM101_API_URL=http://192.168.1.201:8001
# Phase 70.5 Plan 07 — VM107 self-proxy client (Vm107SelfClient).
# vm107-backend container reachable via vm107_network internal DNS on prod.
VM107_API_URL=http://vm107-backend:8000

# =============================================================================
# Phase 67 Plan 12 — FastMCP server (streamable-HTTP transport)
# Required at `docker compose up` time (${VAR:?msg} pattern in compose).
#
# Operational rollout still pending end-to-end:
#   1. Mint JWT signing key + host JWKS at the URL below.
#   2. Issue VM100_INTERNAL_TOKEN and configure VM100 backend (192.168.1.200)
#      to accept it on /api/internal/* — paired secret, both ends must match.
# Until step 1 is done, JWT-protected MCP routes 401. Until step 2 is done,
# MCP→VM100 service calls 401. Agent + Phase 70.5 dispatcher do not use MCP.
# =============================================================================
VM107_MCP_PORT=50091
VM107_MCP_JWKS_URI=http://192.168.1.207:50091/.well-known/jwks.json
VM107_MCP_ISSUER=fingpt-mcp-prod-issuer
VM107_MCP_AUDIENCE=fingpt-mcp-prod
VM100_BASE_URL=http://192.168.1.200:8000
VM100_INTERNAL_TOKEN=10752cc5710adc9913dd82fd0714b6c9974c121b4211fa277a17818003046d48

# =============================================================================
# Qdrant — memory plugin vector backend (VM105 in prod)
# =============================================================================
QDRANT_HOST=192.168.1.105
QDRANT_PORT=6333

# =============================================================================
# Service-to-service authentication for Phase 59 replay tools
# =============================================================================
VM107_SERVICE_TOKEN=ChangeMeInProduction

# =============================================================================
# LLM model defaults (model identifiers, not URLs)
# =============================================================================
CHAT_MODEL=deepseek/deepseek-v4-flash
EVAL_MODEL=deepseek/deepseek-v4-flash

# =============================================================================
# SearXNG web search backend (LOW — dev integration; replace with prod search if used)
# =============================================================================
SEARXNG_URL=http://192.168.1.113:55510/search

# =============================================================================
# Local tunnel proxy (development feature; keep hostname env-driven)
# =============================================================================
TUNNEL_HOST=localhost

# =============================================================================
# WhatsApp bridge manager (dev integration)
# =============================================================================
BRIDGE_HOST=127.0.0.1

# =============================================================================
# Web UI Basic Auth (Agent Zero) — added 2026-05-22
# Set via AUTH_LOGIN/AUTH_PASSWORD; Agent Zero enforces basic auth on the web UI.
# =============================================================================
AUTH_LOGIN=admin
AUTH_PASSWORD=Skippy55Day
