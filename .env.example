# VM107 — example environment variables for new operators.
#
# Copy to .env.local (dev) or .env.production and fill in values.
# Docker compose enforces fail-fast (${VAR:?msg}) on the variables required
# by each service — missing values abort `docker compose up`.
#
# CLAUDE.md lock: env-driven-no-fallbacks. NEVER add `os.getenv("X", "default")`
# at the consumer site — set the value here or let the boot fail.

# ── Phase 67 Plan 12 (FastMCP) ──────────────────────────────────────────────
VM107_MCP_JWKS_URI=
VM107_MCP_ISSUER=
VM107_MCP_AUDIENCE=
VM107_MCP_PORT=50090
VM100_BASE_URL=http://192.168.1.100
VM100_INTERNAL_TOKEN=
VM107_INTERNAL_TOKEN=

# ── Phase 83 Plan 10 (macro emitter) ────────────────────────────────────────
MACRO_EMITTER_SNAPSHOT_URL=http://192.168.1.100/api/v1/mission-control/snapshots/macro
VM107_SERVICE_JWT=
MACRO_EMITTER_REDIS_URL=redis://vm107-redis:6379/0
MACRO_EMITTER_CALENDAR_URL=

# ── Phase 91 Plan 1 (Universal Alert Engine) ────────────────────────────────
# REQUIRED when alerts are enabled on VM100. Producer-side DLQ catches
# omissions but a missing URL means every alert candidate enters DLQ instead
# of dispatch — the intent is to fail-fast on misconfiguration.
# Dev value example: http://192.168.1.100/api/mission-control/internal/alert-candidate-created
# Prod value example: http://<vm100-prod-ip>/api/mission-control/internal/alert-candidate-created
PHASE_91_UAE_URL=

# ── Phase 74 (supervisory + cost anomaly) ───────────────────────────────────
VM107_SUPERVISORY_REDIS_URL=redis://vm107-redis:6379/1
COST_ANOMALY_MULTIPLIER_WARN=2.0
COST_ANOMALY_MULTIPLIER_CRITICAL=4.0
BEHAVIORAL_COOLDOWN_MIN=30
SUPERVISORY_COOLDOWN_ADVISORY_SEC=300
SUPERVISORY_COOLDOWN_WARNING_SEC=120
SUPERVISORY_COOLDOWN_CRITICAL_SEC=30
DAILY_AI_BUDGET_USD=50

# ── Agent telemetry publisher ───────────────────────────────────────────────
AGENT_TELEMETRY_REDIS_URL=redis://vm107-redis:6379/0
AGENT_TELEMETRY_PUBLISH_INTERVAL_SEC=5
AGENT_TELEMETRY_HEALTHZ_PORT=8091
