# VM107 Agent Zero - Development Environment Configuration
# This file contains development environment variables. For production deployments,
# create a separate .env.prod file with production credentials.
# NEVER commit .env.prod to git (it's covered by .gitignore).

# =============================================================================
# Ollama Configuration (REQUIRED)
# =============================================================================
# Points to the shared Ollama instance on the Proxmox host.
# This is critical - without it, local models fail with "Connection refused".
OLLAMA_BASE_URL=http://192.168.1.113:11434

# =============================================================================
# Web UI Configuration
# =============================================================================
# Bind to all interfaces inside container (port 80 is mapped to 50081 externally)
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=80

# =============================================================================
# LLM Provider API Keys (Placeholders)
# =============================================================================
# Uncomment and fill in the API keys you want to use.
# Agent Zero uses LiteLLM to support 30+ providers.
# Configure models through the WebUI settings after first launch.
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=...

# =============================================================================
# Optional Model Pre-configuration
# =============================================================================
# Pre-configure default models via A0_SET_ prefix (optional).
# These override WebUI settings. Remove to configure via UI instead.
#
# A0_SET_chat_model_provider=openrouter
# A0_SET_chat_model_name=anthropic/claude-sonnet-4
# BUG-23 / Phase 62.1: utility tier uses same global model as chat tier.
# Same model identifier = one env-var upgrade covers both tiers simultaneously.
A0_SET_utility_model_provider=deepseek
A0_SET_utility_model_name=deepseek/deepseek-v4-flash
# A0_SET_embedding_model_provider=ollama
# A0_SET_embedding_model_name=nomic-embed-text

# =============================================================================
# Execution Boundary Configuration (Phase 38)
# =============================================================================
# Environment determines which limit profile is loaded from config/boundary.yaml
# Options: production, staging, research
A0_ENVIRONMENT=research

# MongoDB for persistent daily budget tracking
# Dev: 192.168.1.151, Prod: 192.168.1.110
MONGODB_URI=mongodb://192.168.1.151:27017/vm107_budgets

# =============================================================================
# Redis Embedding Cache (Phase 41 enhancement)
# =============================================================================
# Docker service name resolves inside vm107_network
REDIS_URL=redis://vm107-redis:6379/0

# Phase 47.2 — Tier-2 tools + Tier-1 builder talk to VM100 via host.docker.internal
VM100_API_URL=http://host.docker.internal:8000
# BUG-11: Phase 56 event client + PersistNarrativeTool + scope clients read this
VM100_INTERNAL_BASE_URL=http://host.docker.internal:8000
VM102_API_URL=http://host.docker.internal:8003
# Phase 89.1 — VM102 indicator endpoints require DRF JWT bearer auth (simplejwt).
# Same long-lived admin service JWT as VM107_SERVICE_JWT — valid until 2027-06.
VM102_SERVICE_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiY2U4YzRlNDEtZTE3MS00NjE2LWFkMDMtNDM1ZDkyYzEwZGY1IiwiZW1haWwiOiJhZG1pbkB0ZXN0LmNvbSIsInVzZXJuYW1lIjoiYWRtaW4iLCJyb2xlIjoiYWRtaW4iLCJhY2NvdW50X2lkcyI6W10sInB1cnBvc2UiOiJhY2Nlc3MiLCJleHAiOjE4MTM1NDM2MTQsImlhdCI6MTc4MjAwNzYxNH0.EmivHla7bpi5HmKpGOZ0jazyRhHyx6xAT2wyxMotgms
# Phase 70.5 Plan 07 — VM101Client fail-fast (was hardcoded localhost:8001 before)
VM101_API_URL=http://host.docker.internal:8001
# Phase 87 Plan 08 — vm107-macro-story-tracker requires this at compose-parse time
VM101_INTERNAL_BASE_URL=http://host.docker.internal:8001
# Phase 70.5 Plan 07 — VM107 self-proxy client (Vm107SelfClient). vm107-backend
# is on the same vm107_network so reachable via container name on internal port.
VM107_API_URL=http://vm107-backend:8000

# =============================================================================
# Phase 67 Plan 12 — FastMCP server (streamable-HTTP transport)
# All 6 vars are compose-interpolation-required (${VAR:?msg} fail-fast pattern
# in docker-compose.yml) — missing values abort `docker compose up`.
#
# JWKS hosting: The MCP server uses JWTVerifier to validate END-USER JWTs.
# For LOCAL dev: stub URI — JWT verification will fail-closed if you actually
# call the MCP server endpoint. The agent + Phase 70.5 tool dispatcher do
# NOT traverse the MCP server, so this is harmless for normal UAT.
# When you wire real JWT auth: replace JWKS_URI with the URL that serves your
# signing key set (e.g., Auth0/Cognito/Keycloak/your own JWKS endpoint).
#
# VM100_INTERNAL_TOKEN: service-to-service bearer for MCP→VM100 calls. Must
# match the token VM100 accepts for /api/internal/* — local VM100 has no
# matching token configured yet (Plan 67-12 backend wiring pending). Until
# wired both ends, MCP-routed VM100 calls will 401.
# =============================================================================
VM107_MCP_PORT=50091
VM107_MCP_JWKS_URI=http://host.docker.internal:50091/.well-known/jwks.json
VM107_MCP_ISSUER=fingpt-mcp-local-issuer
VM107_MCP_AUDIENCE=fingpt-mcp-local
VM100_BASE_URL=http://host.docker.internal:8000
VM100_INTERNAL_TOKEN=c6b165bd5e6dc1d4b2f2b0f26721e673af32460c8fc98f55ed5555e683f164ee

# Phase 42.1 — VM101 knowledge search endpoint
VM101_KB_SEARCH_URL=http://host.docker.internal:8001/api/v1/knowledge/search

# Qdrant memory plugin backend (dev @ 192.168.1.151)
QDRANT_HOST=192.168.1.151
QDRANT_PORT=6333
# Phase 87 Plan 08 — vm107-macro-story-tracker / B6 EpisodicMemoryService.
# Required at compose-parse time even if you're only touching another service.
QDRANT_URL=http://192.168.1.151:6333
# Phase 87 Plan 10 — vm107-macro-regime-monitor BeliefStore writes.
# Mirrors Dagster .env values for consistent BeliefStore reads/writes.
BELIEF_STORE_POSTGRES_URL=postgresql://postgres:password@192.168.1.151:5432/tradetracker
BELIEF_STORE_MONGO_URL=mongodb://192.168.1.151:27017/tradetracker_analytics
# Phase 87 Plan 10 — vm107-macro-regime-monitor notifies via Phase 74
# dispatcher at /api/v1/notifications/dispatch (on VM100).
PHASE74_DISPATCHER_URL=http://host.docker.internal:8000

# Service-to-service authentication for Phase 59 replay tools (dev — empty allowed)
VM107_SERVICE_TOKEN=

# Phase 73-followup — VM100↔VM107 service-to-service X-API-KEY token.
# Used by VM100 mission_control clients to authenticate against VM107
# (/api/v1/opportunities/ranked, /api/v1/intelligence_feed/macro,
# /api/v1/intelligence_feed/discoveries, /api/v1/narratives/global).
# helpers/api.py's @requires_api_key reads this env var first; falls back
# to settings.json's mcp_server_token when unset. MUST be byte-identical
# to the value in VM100 .env / docker-compose.yml.
VM107_INTERNAL_TOKEN=e578604d429469f22a4940d871cdaa54da3c1856c6466226615c23c14f53fb82

# Phase 73-followup — CAPABILITY_REGISTRY_PERMISSIVE escape hatch RETIRED
# 2026-05-31. The widget yaml ↔ schema drift (active_trade_supervision /
# workflow_action_bar / opportunity_lifecycle_pill carrying dependencies as
# list[dict] when the validator expects list[str]) was reconciled by
# flattening the yamls + preserving the structured info under
# `dependency_details`. VM107 now boots with the LD-2 hard-fail default.
# Re-introducing the flag here without an explicit phase decision is a
# regression — see VM107/tests/boot/test_no_permissive_in_env.py.

# LLM model defaults (model identifiers, not URLs)
CHAT_MODEL=deepseek/deepseek-v4-flash
EVAL_MODEL=deepseek/deepseek-v4-flash

# SearXNG web search backend (dev integration)
SEARXNG_URL=http://localhost:55510/search

# Local tunnel proxy
TUNNEL_HOST=localhost

# WhatsApp bridge manager
BRIDGE_HOST=127.0.0.1

# Phase 60.1 — shared HMAC secret for X-Agent-Scope signing (VM107 signs, VM100 verifies)
SCOPE_DISPATCHER_SECRET_KEY=bfddfca0cd5300fd40ddf7b6d1507d8aad9e8012d300912b265f4c63eb3c6baa

# Phase 60.1 — RFC password for Agent Zero internal function calls (required by _promptinclude extension)
RFC_PASSWORD=33a9043b6ebe16993fd535eb250d3dde

# Phase 47.6 capability registry root (no fallback default per project rule)
CAPABILITY_REGISTRY_ROOT=/a0/registry

# Phase 66 Plan 66-07 — Agent Telemetry Redis channel (REQ-66-4 lock)
# Channel: vm107.agent_telemetry — Plan 66-09 WS multiplexer subscribes here.
VM107_TELEMETRY_REDIS_URL=redis://vm107-redis:6379/0

# Phase 66 Plan 66-07 — IntelligenceFeed VM107 client URLs (REQ-66-3)
# VM100 clients fetch MACRO + DISCOVERIES from these VM107 endpoints.
VM107_INTELLIGENCE_FEED_MACRO_URL=http://vm107-agent-zero:80
VM107_INTELLIGENCE_FEED_DISCOVERIES_URL=http://vm107-agent-zero:80

# Phase 83 Plan 10 — vm107-macro-emitter sibling service (added 2026-06-04 for smoke test)
MACRO_EMITTER_SNAPSHOT_URL=http://host.docker.internal:8000
MACRO_EMITTER_CALENDAR_URL=http://host.docker.internal:8000
MACRO_EMITTER_REDIS_URL=redis://vm107-redis:6379/0
# Refreshed 2026-06-21 — previous token expired 2026-06-11 (7-day default
# from TokenService.generate_access_token). vm107-macro-emitter had been
# silently degraded (tier-3 fallback, 401 on snapshots/macro + calendar/upcoming)
# for ~10 days. New token has 365-day lifetime — service tokens should not
# use the user-access JWT default. Renew before 2027-06-21 OR (better) switch
# to a non-expiring service-token issuance path.
VM107_SERVICE_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiY2U4YzRlNDEtZTE3MS00NjE2LWFkMDMtNDM1ZDkyYzEwZGY1IiwiZW1haWwiOiJhZG1pbkB0ZXN0LmNvbSIsInVzZXJuYW1lIjoiYWRtaW4iLCJyb2xlIjoiYWRtaW4iLCJhY2NvdW50X2lkcyI6W10sInB1cnBvc2UiOiJhY2Nlc3MiLCJleHAiOjE4MTM1NDM2MTQsImlhdCI6MTc4MjAwNzYxNH0.EmivHla7bpi5HmKpGOZ0jazyRhHyx6xAT2wyxMotgms
MACRO_EMITTER_ENABLED=true
POSTGRES_HOST=192.168.1.151
POSTGRES_DB=tradetracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_ANALYTICS_DB=tradetracker_analytics

# Phase 89 Plan 09 — ContradictionEngine (B13) requires this at startup (fail-fast, no default).
# Points at tradetracker_analytics where macro_contradictions + macro_discovery_proposals tables live.
# Rule 2 auto-fix: added 2026-06-21 during 89-09 Task 1 pre-flight check.
CONTRADICTION_POSTGRES_URL=postgresql://postgres:postgres@192.168.1.151:5432/tradetracker_analytics

# Phase 89.2 — discovery proposals share the same DB as contradictions (tradetracker_analytics).
# DISCOVERY_POSTGRES_URL is read fail-fast by VM107/core/discovery/edge_proposer.py
# and VM107/core/discovery/throughput_governor.py at call time (no default per env-driven lock).
DISCOVERY_POSTGRES_URL=postgresql://postgres:postgres@192.168.1.151:5432/tradetracker_analytics

# Phase 89.2 — Neo4j bolt URI for VM107/services/neo4j_edge_proposal_writer.py.
# Reused from Phase 87 Neo4j macro graph (same server as Qdrant at .105).
NEO4J_URI=bolt://192.168.1.105:7687
